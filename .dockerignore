# .dockerignore — danh sách file KHÔNG copy vào image khi gặp lệnh COPY . .
# Tác dụng: image nhẹ hơn, build nhanh hơn, không lộ file nhạy cảm (.env).
# Mỗi dòng là 1 quy tắc, cú pháp giống .gitignore.

# Thư viện đã cài ở máy bạn — trong Docker ta cài lại từ đầu (stage deps), nên bỏ qua.
node_modules

# Kết quả build cũ ở máy bạn — trong Docker ta build lại (stage builder), nên bỏ qua.
.next
out
build

# File git — không cần mang lịch sử commit vào image.
.git
.gitignore

# File môi trường chứa key/mật khẩu — KHÔNG nên đóng cứng vào image.
# Khi chạy thì truyền bằng: docker run --env-file .env ...
.env
.env*
!.env.example

# File của Docker chính nó — không cần copy vào image.
Dockerfile
.dockerignore

# File tài liệu / cấu hình máy dev — không cần khi chạy production.
README.md
envs
.next
coverage

# File hệ điều hành / editor tự sinh ra.
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Thư mục test bạn đang loại trừ trong .gitignore.
src/app/screens/test/
src/app/test/

# TypeScript build info.
*.tsbuildinfo
next-env.d.ts

# Vercel.
.vercel
